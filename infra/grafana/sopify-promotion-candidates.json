{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Sopify Promotion Candidates dashboard. Satisfies REQ-7.3.3 (DESIGN_ARCHITECTURE.md). Surfaces 'vibe-mode' app fingerprints used more than 3 times in the last 7 days as candidates for promotion to a managed/blessed Sopify app, ranks them by cost, and tracks how the candidate funnel grows over time. IT-admin-only (REQ-7.4.3, enforce via Grafana RBAC).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "description": "Vibe-mode app fingerprints used more than 3 times in the dashboard time range (default 7d). Columns: app_fingerprint, user count (distinct users), total sessions (distinct session_ids), total cost (USD), first seen, last seen.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true,
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "total_cost_usd"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "mode": "gradient",
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "uses"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "mode": "gradient",
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": true,
          "fields": "",
          "reducer": ["count"],
          "show": true
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "uses"
          }
        ]
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "editorMode": "code",
          "expr": "topk(100, sum by (app_fingerprint) (count_over_time({event_type=\"user_prompt\"} | json | sopify_mode=\"vibe\" | app_fingerprint != \"\" [$__range])) > 3)",
          "queryType": "instant",
          "refId": "uses"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "editorMode": "code",
          "expr": "count by (app_fingerprint) (count by (app_fingerprint, user_email) (count_over_time({event_type=\"user_prompt\"} | json | sopify_mode=\"vibe\" | app_fingerprint != \"\" [$__range])))",
          "queryType": "instant",
          "refId": "user_count"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "editorMode": "code",
          "expr": "count by (app_fingerprint) (count by (app_fingerprint, session_id) (count_over_time({event_type=\"user_prompt\"} | json | sopify_mode=\"vibe\" | app_fingerprint != \"\" [$__range])))",
          "queryType": "instant",
          "refId": "total_sessions"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "editorMode": "code",
          "expr": "sum by (app_fingerprint) (sum_over_time({event_type=\"api_request\"} | json | sopify_mode=\"vibe\" | app_fingerprint != \"\" | unwrap cost_usd [$__range]))",
          "queryType": "instant",
          "refId": "total_cost_usd"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "editorMode": "code",
          "expr": "min by (app_fingerprint) (min_over_time({event_type=\"user_prompt\"} | json | sopify_mode=\"vibe\" | app_fingerprint != \"\" | unwrap timestamp_unix [$__range]))",
          "queryType": "instant",
          "refId": "first_seen"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "editorMode": "code",
          "expr": "max by (app_fingerprint) (max_over_time({event_type=\"user_prompt\"} | json | sopify_mode=\"vibe\" | app_fingerprint != \"\" | unwrap timestamp_unix [$__range]))",
          "queryType": "instant",
          "refId": "last_seen"
        }
      ],
      "title": "Apps used > 3 times in the last 7 days",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "app_fingerprint",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "app_fingerprint": 0,
              "first_seen": 4,
              "last_seen": 5,
              "total_cost_usd": 3,
              "total_sessions": 2,
              "user_count": 1,
              "uses": 6
            },
            "renameByName": {
              "Value #first_seen": "first_seen",
              "Value #last_seen": "last_seen",
              "Value #total_cost_usd": "total_cost_usd",
              "Value #total_sessions": "total_sessions",
              "Value #user_count": "user_count",
              "Value #uses": "uses"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "description": "Top 20 vibe-mode app fingerprints ranked by total API cost in USD over the dashboard time range.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "USD",
            "axisPlacement": "auto",
            "fillOpacity": 80,
            "gradientMode": "scheme",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "lineWidth": 1,
            "scaleDistribution": {
              "type": "linear"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "decimals": 2,
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "id": 2,
      "options": {
        "barRadius": 0,
        "barWidth": 0.7,
        "fullHighlight": false,
        "groupWidth": 0.7,
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "orientation": "horizontal",
        "showValue": "always",
        "stacking": "none",
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "editorMode": "code",
          "expr": "topk(20, sum by (app_fingerprint) (sum_over_time({event_type=\"api_request\"} | json | sopify_mode=\"vibe\" | app_fingerprint != \"\" | unwrap cost_usd [$__range])))",
          "legendFormat": "{{app_fingerprint}}",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Cost ranked - top 20 fingerprints",
      "type": "barchart"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "description": "Per-day count of distinct app_fingerprints whose rolling 7-day vibe-mode usage crosses the >3 promotion threshold. Tracks how fast the candidate funnel grows.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "candidate count",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "lineInterpolation": "stepBefore",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "id": 3,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "editorMode": "code",
          "expr": "count(sum by (app_fingerprint) (count_over_time({event_type=\"user_prompt\"} | json | sopify_mode=\"vibe\" | app_fingerprint != \"\" [7d])) > 3)",
          "legendFormat": "candidates crossing >3 threshold",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Promotion candidates over time (rolling 7d, threshold > 3)",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
