# Daily backup timer (REQ-3.1.4).
# Pairs with sopify-backup.service. Install:
#   cp sopify-backup.{service,timer} ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now sopify-backup.timer

[Unit]
Description=Sopify daily backup timer

[Timer]
OnCalendar=*-*-* 02:00:00
RandomizedDelaySec=900
Persistent=true

[Install]
WantedBy=timers.target
