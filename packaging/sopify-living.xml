<!--
  Windows Service definition for Sopify /living using WinSW
  (REQ-3.1.2 Windows path). https://github.com/winsw/winsw

  Install (PowerShell, admin):
    Copy-Item packaging\sopify-living.xml C:\ProgramData\Sopify\sopify-living.xml
    winsw.exe install   C:\ProgramData\Sopify\sopify-living.xml
    winsw.exe start     C:\ProgramData\Sopify\sopify-living.xml

  Status:  winsw.exe status   C:\ProgramData\Sopify\sopify-living.xml
  Stop:    winsw.exe stop     C:\ProgramData\Sopify\sopify-living.xml
  Logs:    C:\ProgramData\Sopify\logs\sopify-living.log
-->
<service>
  <id>sopify-living</id>
  <name>Sopify /living</name>
  <description>Sopify /living — 24/7 AI employee</description>
  <executable>%LOCALAPPDATA%\Sopify\bin\sopify.cmd</executable>
  <arguments>/living</arguments>

  <logpath>%PROGRAMDATA%\Sopify\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>5</keepFiles>
  </log>

  <onfailure action="restart" delay="30 sec"/>
  <env name="SOPIFY_NO_BANNER" value="1"/>

  <!-- Run as the interactive user, not LocalSystem (REQ-11.4 spirit). -->
  <serviceaccount>
    <username>NT AUTHORITY\LocalService</username>
  </serviceaccount>
</service>
