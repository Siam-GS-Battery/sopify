        "  --no-sandbox         skip Docker sandbox (dev role only)\n"
    )


def _cmd_version() -> int:
    # `--version` is meant to be machine-friendly; show banner only if TTY.
    _show_banner()
    from importlib import import_module
    version = import_module("plugins.sopify_core.version")  # type: ignore[attr-defined]
    print(version.full_version_string())
    return 0


def _cmd_install() -> int:
    _show_banner(subtitle="Installing — Docker sandbox + network + config")
    from importlib import import_module
    install = import_module("plugins.sopify_core.install")  # type: ignore[attr-defined]
    report = install.run()
    print(install.format_report(report))
    return 0 if report.ok else 1


def _cmd_doctor() -> int:
    _show_banner(subtitle="Doctor — auth / sandbox / OTel health check")
    from importlib import import_module
    doctor = import_module("plugins.sopify_core.doctor")  # type: ignore[attr-defined]
    report = doctor.run()
    print(doctor.format_report(report))
    return 0 if report.ok else 1


def _spawn_sandbox(argv: list[str]) -> int:
    """REQ-1.2.1 / 1.2.2 — every other command runs inside the container."""
    from importlib import import_module
    try:
        launcher = import_module("plugins.sopify_sandbox.launcher")  # type: ignore[attr-defined]
    except ImportError:
        print(
            "sopify: sandbox plugin not installed — run `sopify install` first.",
            file=sys.stderr,
        )
        return 2
    return launcher.spawn(argv)


def _sbx_available() -> bool:
    """Check if Docker Sandboxes (sbx) CLI is installed + logged in."""
    if os.environ.get("SOPIFY_NO_SBX") == "1":
        return False
    try:
        from importlib import import_module
        sbx = import_module("plugins.sopify_sandbox.sbx_launcher")
        return sbx.is_available() and sbx.is_logged_in()
    except Exception:
        return False


def _delegate_to_hermes(argv: list[str], *, publish_ports: list[int] | None = None) -> int:
    """Run the underlying runtime.

    Preferred path: route through `sbx run shell` so the runtime lives in a
    Docker microVM with org-managed network policy + env passthrough applied
    by the Sopify kit (REQ-1.2.1 / REQ-9.1).

    Fallback: when sbx isn't installed or the user explicitly opted out
    (SOPIFY_NO_SBX=1), run Hermes directly on the host with sopify plugins
    preloaded. Sopify governance (guardrails, OTel emit, mode profiles)
    still fires but without sandbox isolation.
    """
    if _sbx_available():
        from importlib import import_module
        sbx = import_module("plugins.sopify_sandbox.sbx_launcher")
        # Make sopify wrapper visible inside the microVM via the kit's
        # startup script. argv here is what runs after sbx mounts + boots.
        return sbx.spawn(argv, publish_ports=publish_ports)

    # Host fallback.
    _preload_sopify_plugins()
    try:
        from hermes_cli.main import main as hermes_main  # type: ignore[import]
    except ImportError as exc:
        print(f"sopify: cannot launch runtime ({exc})", file=sys.stderr)
        print("        Did `sopify install` finish?", file=sys.stderr)
        return 2
    sys.argv = [sys.argv[0]] + list(argv)
    rc = hermes_main()
    return rc if isinstance(rc, int) else 0


def _preload_sopify_plugins() -> None:
    """Import every `plugins/sopify_*` package so hooks register on startup."""
    import importlib
    import pathlib

    plugin_dir = pathlib.Path(ROOT) / "plugins"
    for child in sorted(plugin_dir.iterdir()):
        if child.is_dir() and child.name.startswith("sopify_"):
            try:
                importlib.import_module(f"plugins.{child.name}")
            except Exception as exc:
                print(f"sopify: plugin {child.name} failed to load: {exc}",
                      file=sys.stderr)


def _ensure_encm_daemon_running() -> None:
    """Auto-start the ENCM daemon on the host so /network works.

    The daemon talks to the host's sandboxd over a Unix socket — that file
    only exists on the host, so the daemon stays on the host even though
    the dashboard runs inside a microVM. The dashboard reaches the daemon
    via ``host.docker.internal:7777`` (see hermes_cli/encm_client.py).

    Skip when already running, when the user is offline-mode (SOPIFY_NO_SBX),
    or when we're already inside a sandbox (the host-side launcher is the
    one responsible for boot — a nested sbx exec would just no-op anyway).
    Best-effort: we never block dashboard launch on a daemon hiccup.
    """
    if os.environ.get("SOPIFY_IN_SANDBOX") == "1":
        return  # nested call from inside the microVM — host already handled this
    if os.environ.get("SOPIFY_NO_ENCM") == "1":
        return  # opt-out for users who don't want ENCM autostart

    # Probe /health first — cheaper than parsing pid files. urllib is
    # stdlib so this stays import-light.
    import urllib.error
    import urllib.request
    try:
        with urllib.request.urlopen("http://127.0.0.1:7777/health", timeout=0.5) as resp:
            if resp.status == 200:
                return  # already up
    except (urllib.error.URLError, TimeoutError, OSError):
        pass  # not running — start it

    # Spawn in a new session so it survives this shim's exit. Pipe stdio
    # to a log file so the user can `tail -f ~/.sopify/daemon.log` if they
    # need to debug, but the dashboard banner stays clean.
    import subprocess
    log_dir = os.path.expanduser("~/.sopify")
    os.makedirs(log_dir, exist_ok=True)
    log_path = os.path.join(log_dir, "daemon.log")
    try:
        with open(log_path, "ab") as logf:
            subprocess.Popen(
                [sys.executable, os.path.join(ROOT, "sopify"), "start"],
                stdout=logf, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                start_new_session=True,
                cwd=ROOT,
            )
    except OSError as exc:
        print(f"sopify: failed to auto-start ENCM daemon: {exc}", file=sys.stderr)
        return

    # Wait briefly for the daemon to bind so the dashboard's first call
    # finds it up. 3s is plenty (uvicorn startup is ~500ms here); past
    # that we let the user see the daemon-down banner in /network rather
    # than blocking dashboard boot.
    import time
    for _ in range(30):
        time.sleep(0.1)
        try:
            with urllib.request.urlopen("http://127.0.0.1:7777/health", timeout=0.2) as resp:
                if resp.status == 200:
                    return
        except (urllib.error.URLError, TimeoutError, OSError):
            continue


def _cmd_dashboard(argv: list[str]) -> int:
    """sopify dashboard — open the web UI in a browser.

    The dashboard is the recommended UX for non-engineers: it gives a
    chat pane (when `--tui` is enabled, which we default to ON for Sopify),
    config editor, session browser, and skill/tool inspector — all in
    the browser, no terminal commands needed.
    """
    _show_banner(subtitle="Dashboard — opening browser UI")

    # ``--no-browser`` is the Sopify-side spelling of "headless launch" —
    # used in CI / SSH / Codespaces where Chrome can't open. Strip it from
    # the args forwarded to hermes (hermes uses ``--no-open``, which we
    # add automatically below) and signal sbx_launcher via env var to
    # suppress the host-side auto-open. Same spelling as Jupyter.
    if "--no-browser" in argv:
        os.environ["SOPIFY_NO_BROWSER"] = "1"
        argv = [a for a in argv if a != "--no-browser"]

    # Auto-start the ENCM daemon on the host before the sandbox boots so
    # the /network page works immediately. Failures are non-fatal — the
    # dashboard still launches and /network renders a daemon-down state.
    _ensure_encm_daemon_running()
    # Auto-enable the in-browser Chat tab so the user can talk to Sopify
    # immediately. They can still pass --no-chat-pane explicitly.
    hermes_args = ["dashboard"] + argv
    if "--tui" not in hermes_args and "--no-chat-pane" not in hermes_args:
        hermes_args.append("--tui")
    # When running inside the sbx microVM, Hermes' default --host=127.0.0.1
    # binds to the microVM's loopback, which sbx port-publishing can't
    # reach from the host. Force 0.0.0.0 so the published 9119:9119 mapping
    # actually serves the host browser. --insecure is required to allow
    # non-localhost binding (safe here: only the host network sees this
    # via the explicit sbx publish — there's no exposure to anyone else).
    if os.environ.get("SOPIFY_IN_SANDBOX") == "1":
        if "--host" not in hermes_args:
            hermes_args.extend(["--host", "0.0.0.0"])
        if "--insecure" not in hermes_args:
            hermes_args.append("--insecure")
        if "--no-open" not in hermes_args:
            # No browser inside the microVM — the host launcher opens it.
            hermes_args.append("--no-open")
    # Publish 9119 from microVM to host so the browser can reach it.
    return _delegate_to_hermes(hermes_args, publish_ports=[9119])


def _cmd_chat(argv: list[str]) -> int:
    """sopify chat — open the Sopify TUI in the current terminal."""
    _show_banner(subtitle="Chat — terminal UI")
    return _delegate_to_hermes(argv or [])


def _cmd_login(argv: list[str]) -> int:
    """sopify login — host-side API key setup. Writes ~/.sopify/auth.json."""
    _show_banner(subtitle="Login — set up API key")
    from importlib import import_module
    auth = import_module("plugins.sopify_providers.auth")  # type: ignore[attr-defined]
    auth.login_interactive()
    return 0


def _cmd_logout(argv: list[str]) -> int:
    """sopify logout — zero-fill and remove credentials."""
    _show_banner(subtitle="Logout — zero-fill credentials")
    from importlib import import_module
    auth = import_module("plugins.sopify_providers.auth")  # type: ignore[attr-defined]
    provider = argv[0] if argv else None
    auth.logout(provider)
    print("sopify: credentials cleared.")
    return 0


def _cmd_env(argv: list[str]) -> int:
    """sopify env — read/write credentials in ~/.hermes/.env directly.

    Writes the canonical Hermes env file that the microVM mounts read-only,
    so updates are picked up by the next sandbox boot without rebuilding.
    """
    _show_banner(subtitle="Env — manage ~/.hermes/.env credentials")
    from importlib import import_module
    env_cli = import_module("plugins.sopify_providers.env_cli")  # type: ignore[attr-defined]
    return env_cli.main(argv)


def _cmd_onboard(argv: list[str]) -> int:
    """sopify onboard — welcome + audit consent flow."""
    _show_banner(subtitle="Onboard — welcome + audit consent")
    from importlib import import_module
    onboard = import_module("plugins.sopify_management.onboard")  # type: ignore[attr-defined]
    return onboard.run_interactive()


def _cmd_mode(mode_arg: str, argv: list[str]) -> int:
    """sopify /vibe | /living | /code-with-you — slash-command mode entry.

    Current implementation runs on the host (via _delegate_to_hermes) with
    sopify plugins preloaded so guardrails/OTel/skill injection are active.
    A future revision will run inside the sandbox image once that build is
    verified end-to-end.
    """
    name = mode_arg.lstrip("/")
    _show_banner(subtitle=f"Mode: /{name}")
    # Activate the mode profile before handing off so sopify_modes.active_mode()
    # reflects the user's choice from the very first turn.
    try:
        from importlib import import_module
        modes = import_module("plugins.sopify_modes")
        modes._activate(name)
    except Exception as exc:
        print(f"sopify: failed to activate mode {name}: {exc}", file=sys.stderr)
    return _delegate_to_hermes(argv)


def main(argv: list[str]) -> int:
    if len(argv) <= 1 or argv[1] in ("-h", "--help"):
        _print_help()
        return 0
    if argv[1] in ("-V", "--version", "version"):
        return _cmd_version()
    sub = argv[1]
    # ENCM Control Plane commands (SOPIFY_ENCM_SBX_INTEGRATION_PLAN.md).
    # These hit the local daemon's REST API; the daemon itself runs via
    # `sopify start`. CLI never reads YAML / talks to sandboxd directly.
    encm_commands = {"start", "stop", "status", "rules", "audit", "reconcile", "drift"}
    # Common typos that would otherwise fall through to the Hermes runtime
    # (spawning a sandbox just to print "invalid choice"). Map them back
    # to the canonical command so a slipped 's' doesn't burn 5s + an
    # sbx container.
    encm_typos = {
        "rule": "rules",      # singular → plural
        "auditing": "audit",
        "drift-list": "drift",
        "reconciler": "reconcile",
    }
    if sub in encm_commands:
        from importlib import import_module
        cli_mod = import_module("sopify_daemon.cli")
        return cli_mod.dispatch([sub, *argv[2:]])
    if sub in encm_typos:
        print(
            f"sopify: did you mean `sopify {encm_typos[sub]}`? "
            f"(`{sub}` isn't a Sopify command — refusing to fall through "
            f"to the Hermes runtime)",
            file=sys.stderr,
        )
        return 2
    if sub == "install":
        return _cmd_install()
    if sub == "doctor":
        return _cmd_doctor()
    if sub == "dashboard":
        return _cmd_dashboard(argv[2:])
    if sub == "chat":
        return _cmd_chat(argv[2:])
    if sub == "login":
        return _cmd_login(argv[2:])
    if sub == "logout":
        return _cmd_logout(argv[2:])
    if sub == "env":
        return _cmd_env(argv[2:])
    if sub == "onboard":
        return _cmd_onboard(argv[2:])
    # Mode slash commands route to the Hermes runtime with sopify plugins
    # preloaded. The Docker sandbox path is scaffolded but not yet wired
    # end-to-end; it'll be re-enabled once the sandbox image is verified.
    if sub in ("/vibe", "/living", "/code-with-you",
               "vibe", "living", "code-with-you"):
        slash = sub if sub.startswith("/") else f"/{sub}"
        return _cmd_mode(slash, argv[2:])
    # Last resort — pass through to Hermes (for `sopify model`, `sopify plugins`,
    # etc. — anything the user might run that Hermes natively handles).
    return _delegate_to_hermes(argv[1:])






if __name__ == "__main__":
    sys.exit(main(sys.argv))
